  "info": {
    "_postman_id": "55fb5ac1-54cb-472e-82c0-191b4c86093b",
    "name": "Thoughtly agent contact API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": {
      "content": "The Thoughtly API lets you programmatically manage voice and chat AI agents,\ncontacts, calls, webhooks, and automations. Voice Agents are referenced in\nthe API as \"interviews\" for historical reasons. Authentication uses two\nheaders: `x-api-token` and `team_id`, both available from the Developer\nSettings page of the Thoughtly dashboard.\n\n\nContact Support:\n Name: Thoughtly Support\n Email: support@thoughtly.com",
      "type": "text/plain"
    }
  }
